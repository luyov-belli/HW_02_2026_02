# Entornos
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Insumos crudos: se regeneran con `python -m src.acquisition`.
# Su procedencia, licencia, tamaño y SHA-256 quedan en data/raw/manifest.json,
# que sí se versiona.
data/raw/*
!data/raw/manifest.json

# Caché de ruteo: las matrices .npz intermedias pesan cientos de MB y son
# reconstruibles. Los resultados que consume el dashboard viven en data/outputs/
# y sí se versionan.
data/cache/

# Salidas del alcance "dev" (un solo departamento). Existe para probar el
# pipeline completo en segundos y sus resultados NO son resultados del estudio;
# versionarlos invitaría a confundir metrics_national_dev.csv con la corrida
# nacional. Los alcances "national" y "regions" sí se versionan.
#
# Config.path() manda todo el alcance "dev" a directorios paralelos, así que basta
# con ignorar esos. Las líneas por patrón se mantienen para las salidas que ya
# llevan el alcance en el nombre.
data/outputs_dev/
data/outputs_test/
data/outputs/*_dev.csv
data/outputs/*_dev.json
data/outputs/*_dev*.parquet
data/processed/*_dev.parquet
data/processed/*_dev.gpkg

# Artefactos de OSRM generados por osrm-extract/partition/customize
osrm/
*.osrm*

# Figuras y tablas del informe: las genera src/export.py y su contenido depende
# del alcance de la corrida. Los workflows las agregan con `git add -f` después
# de generarlas con los datos nacionales, así que las que llegan al repositorio
# son siempre las oficiales.
#
# Ojo: como están force-added, ya son archivos *rastreados* y estas dos líneas no
# impiden que una corrida local las sobrescriba. La protección de verdad está en
# Config.path(), que en el alcance "dev" escribe en los directorios de abajo.
report/figures/
report/tables/
report/figures_dev/
report/tables_dev/
report/figures_test/
report/tables_test/
logs_dev/
logs_test/

# LaTeX
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg

# Sistema
.DS_Store
Thumbs.db
