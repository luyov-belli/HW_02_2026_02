# Entornos
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Insumos crudos: se regeneran con `python -m src.acquisition`.
# Su procedencia, licencia, tamaño y SHA-256 quedan en data/raw/manifest.json,
# que sí se versiona.
data/raw/*
!data/raw/manifest.json

# Caché de ruteo: las matrices .npz intermedias pesan cientos de MB y son
# reconstruibles. Los resultados que consume el dashboard viven en data/outputs/
# y sí se versionan.
data/cache/

# Salidas del alcance "dev" (un solo departamento). Existe para probar el
# pipeline completo en segundos y sus resultados NO son resultados del estudio;
# versionarlos invitaría a confundir metrics_national_dev.csv con la corrida
# nacional. Los alcances "national" y "regions" sí se versionan.
data/outputs/*_dev.csv
data/outputs/*_dev.json
data/outputs/*_dev*.parquet
data/processed/*_dev.parquet
data/processed/*_dev.gpkg

# Artefactos de OSRM generados por osrm-extract/partition/customize
osrm/
*.osrm*

# LaTeX
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg

# Sistema
.DS_Store
Thumbs.db
